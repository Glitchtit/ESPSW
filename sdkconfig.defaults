# ESPSW default sdkconfig — esp32c6 Zigbee router + relay.

# --- Zigbee: Router (coordinator/router build), native 802.15.4 radio ---
CONFIG_ZB_ENABLED=y
CONFIG_ZB_ZCZR=y
CONFIG_ZB_RADIO_NATIVE=y

# --- Partition table with Zigbee storage (dual-slot OTA) ---
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# --- OTA: new image must self-confirm or the bootloader reverts ---
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# --- Flash (XIAO ESP32-C6 has 4 MB) ---
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# --- Recommended for Zigbee stack timing ---
CONFIG_FREERTOS_HZ=1000

# --- Console on the native USB-Serial-JTAG (XIAO has no UART bridge) ---
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# --- Logging ---
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
